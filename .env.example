# Copy to .env.local (or Coolify env) and fill in. Never commit real secrets.

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Get an API key at https://resend.com — required to send guest emails.
RESEND_API_KEY=
# From address must be a verified domain in Resend.
# Example: BokoBoko <bookings@example.com>
EMAIL_FROM=
# Optional. Guest replies go here if set.
EMAIL_REPLY_TO=

# ── Beds24 ──────────────────────────────────────────────────────────────────
BEDS24_REFRESH_TOKEN=

# ── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_SECRET=
# Optional. Set after generating a secret in /admin/settings.
# ADMIN_TOTP_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://book.bokoboko.org
GHS_PER_USD=15.5
NEXT_PUBLIC_GHS_PER_USD=15.5
CRON_SECRET=

# ── Optional integrations ───────────────────────────────────────────────────
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_API_URL=https://www.zohoapis.com/crm/v2
# NEXT_PUBLIC_CALENDLY_URL=
# CALENDLY_WEBHOOK_SIGNING_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Future: Pass.mess WhatsApp (not wired — see docs/pass-mess-whatsapp.md) ─
# PASSMESS_API_KEY=
# PASSMESS_SENDER=
